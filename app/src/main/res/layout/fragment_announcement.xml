<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Broadcast Announcement"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/on_background"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAnnouncementTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Announcement Title"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAnnouncementMessage"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Message"
            android:gravity="top"
            android:inputType="textMultiLine" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Target Audience"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/on_background"
        android:layout_marginBottom="6dp" />

    <RadioGroup
        android:id="@+id/rgTargetAudience"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        <RadioButton
            android:id="@+id/rbTargetAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All"
            android:textColor="#0F172A"
            android:checked="true"
            android:layout_marginEnd="16dp" />
        <RadioButton
            android:id="@+id/rbTargetStudent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#0F172A"
            android:text="Students"
            android:layout_marginEnd="16dp" />
        <RadioButton
            android:id="@+id/rbTargetAlumni"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#0F172A"
            android:text="Alumni" />
    </RadioGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSendAnnouncement"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Publish Broadcast"
        app:cornerRadius="8dp" />
</LinearLayout>
