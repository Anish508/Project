<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_admin"
    app:startDestination="@id/nav_admin_home">

    <fragment
        android:id="@+id/nav_admin_home"
        android:name="com.alumni.connect.ui.admin.AdminHomeFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_admin_home" />

    <fragment
        android:id="@+id/nav_user_management"
        android:name="com.alumni.connect.ui.admin.UserManagementFragment"
        android:label="User Management"
        tools:layout="@layout/fragment_user_management">
        <action
            android:id="@+id/action_users_to_detail"
            app:destination="@id/nav_user_detail" />
    </fragment>

    <fragment
        android:id="@+id/nav_user_detail"
        android:name="com.alumni.connect.ui.admin.UserDetailFragment"
        android:label="User Details"
        tools:layout="@layout/fragment_user_detail" />

    <fragment
        android:id="@+id/nav_content_moderation"
        android:name="com.alumni.connect.ui.admin.ContentModerationFragment"
        android:label="Content Moderation"
        tools:layout="@layout/fragment_content_moderation" />

    <fragment
        android:id="@+id/nav_event_management"
        android:name="com.alumni.connect.ui.admin.EventManagementFragment"
        android:label="Event Management"
        tools:layout="@layout/fragment_event_management">
        <action
            android:id="@+id/action_events_to_create"
            app:destination="@id/nav_create_event" />
    </fragment>

    <fragment
        android:id="@+id/nav_create_event"
        android:name="com.alumni.connect.ui.events.CreateEventFragment"
        android:label="Create Event"
        tools:layout="@layout/fragment_create_event" />

    <fragment
        android:id="@+id/nav_announcement"
        android:name="com.alumni.connect.ui.admin.AnnouncementFragment"
        android:label="Announcements"
        tools:layout="@layout/fragment_announcement" />

    <fragment
        android:id="@+id/nav_admin_settings"
        android:name="com.alumni.connect.ui.admin.AdminSettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_admin_settings" />
</navigation>
